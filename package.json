{
  "name": "felsefe-haberleri",
  "version": "0.1.0",
  "private": true,
  "description": "Felsefe Haberleri — yaşayan filozoflardan haberler; Next.js tabanlı haber sitesi ve mobil uygulama için headless API.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx prisma/check-content.ts && prisma db push --skip-generate && tsx prisma/content-sync.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "setup": "prisma migrate dev --name init && prisma db seed",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "content:sync": "tsx prisma/content-sync.ts",
    "content:check": "tsx prisma/check-content.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/typography": "^0.5.20",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
